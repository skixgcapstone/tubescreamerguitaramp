[Unit]
Description=Tube Screamer Amplifier Touchscreen
After=graphical-session.target sound.target
Wants=graphical-session.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/capstoneSoftwareDemo
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=/home/pi/capstoneSoftwareDemo/.venv/bin/python /home/pi/capstoneSoftwareDemo/main.py --fullscreen --live-input
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
